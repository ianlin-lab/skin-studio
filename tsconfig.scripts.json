{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
